[Unit]
Description=RAID Studio Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/bizon/raid_managment_software_2025
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bizon/raid_managment_software_2025/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
